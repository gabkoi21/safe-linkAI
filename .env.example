# Copy values into the ignored root .env. Never commit real credentials.
FASTAPI_ENV=development
PROJECT_NAME="SafeLink AI"
SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Paste the PostgreSQL connection string from your Neon project's Connect dialog.
# Preserve its TLS query parameters. The backend selects the psycopg driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Gemma 4 through the Google AI Studio / Gemini API.
# Supported model: https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it
